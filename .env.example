# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/flightagent"

# Base URL of the Python agent service (FastAPI). Local dev default shown.
AGENT_SERVICE_URL="http://localhost:8000"

# Which LLM backend the agent uses: "anthropic" (hosted) or "ollama" (local).
LLM_PROVIDER="ollama"

# Base URL of a local Ollama server. Only used when LLM_PROVIDER="ollama".
OLLAMA_BASE_URL="http://localhost:11434"

# Anthropic API key. Only used when LLM_PROVIDER="anthropic". Never commit real keys.
ANTHROPIC_API_KEY="sk-ant-..."

# FastMCP transport mode
TRANSPORT_MODE="stdio"
